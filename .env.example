# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key. Server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Webapp access ---
# Password required to open the admin area (/admin). Set this in Vercel -> Environment Variables.
ADMIN_PASSWORD=change-me

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-chars

# Random secret used to encrypt the bundle.social API key at rest. Generate the same way.
ENCRYPTION_KEY=replace-with-64-hex-chars

# --- Optional ---
# Public URL of the deployment (no trailing slash). Used to build the OAuth redirect URL.
# If omitted, the app derives it from the incoming request (works on Vercel).
# NEXT_PUBLIC_SITE_URL=https://connect.yourdomain.com
